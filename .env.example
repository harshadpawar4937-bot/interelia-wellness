# Copy to .env for docker compose (never commit secrets)
SECRET_KEY=replace-with-long-random-string-at-least-32-chars
POSTGRES_USER=interelia
POSTGRES_PASSWORD=replace-strong-db-password
POSTGRES_DB=interelia_pharmacy
ENVIRONMENT=production
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_CHAT_MODEL=llama-3.1-8b-instant
ENABLE_API_DOCS=false
STOREFRONT_PORT=8080
ADMIN_PORT=8081

# Railway notes (set in Railway dashboard, not this file):
# - Link Postgres → DATABASE_URL
# - AUTO_SEED_ON_EMPTY=true on first API deploy
