# Interelia Wellness API
SECRET_KEY=change-me-in-production-interelia-pharmacy-secret
ENVIRONMENT=development
# SQLite (default) or Postgres:
# DATABASE_URL=postgresql://interelia:interelia@localhost:5432/interelia_pharmacy
DATABASE_URL=sqlite:///./interelia_pharmacy.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176

# Groq (recommended) or any OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_CHAT_MODEL=llama-3.1-8b-instant
FINE_TUNED_MODEL_ID=
UPLOAD_DIR=./uploads
AI_RATE_LIMIT_PER_MINUTE=20
ENABLE_API_DOCS=true

# Express delivery hub (Gota, Ahmedabad)
STORE_LAT=23.1016
STORE_LNG=72.5402
STORE_ADDRESS=Interelia Wellness, Gota, Ahmedabad 382481
DELIVERY_RADIUS_KM=6
DELIVERY_ETA_MINUTES=30
DELIVERY_FEE=49
FREE_DELIVERY_MIN=499
